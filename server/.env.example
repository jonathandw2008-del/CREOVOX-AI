# CREOVOX AI server configuration. Copy to server/.env and fill in what you need.
# server/.env is git-ignored. Never commit real keys.

# --- Core ---------------------------------------------------------------
ENVIRONMENT=development
# PostgreSQL (docker compose up -d db). For a quick local try without Docker use:
#   DATABASE_URL=sqlite:///./creovox.db
DATABASE_URL=postgresql+psycopg://creovox:creovox@localhost:5432/creovox
FRONTEND_ORIGIN=http://localhost:5173
# STORAGE_DIR=./storage
# MAX_UPLOAD_BYTES=2147483648

# --- Auth ---------------------------------------------------------------
# Production: openssl rand -hex 32
SESSION_SECRET=dev-insecure-secret-change-me
COOKIE_SECURE=false
# Optional "Continue with Google" (OAuth client ID, type "Web application").
GOOGLE_CLIENT_ID=

# --- Email sign-in codes ------------------------------------------------
# Leave SMTP_HOST empty to print codes in the API terminal instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CREOVOX AI <no-reply@creovox.local>
SMTP_STARTTLS=true

# --- AI -----------------------------------------------------------------
# auto = Groq if GROQ_API_KEY is set, else Claude if ANTHROPIC_API_KEY is set, else off (heuristics).
AI_PROVIDER=auto
# https://console.groq.com/keys (also powers fast Whisper transcription)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- Transcription ------------------------------------------------------
# auto = Groq Whisper when GROQ_API_KEY is set, else local faster-whisper.
TRANSCRIBE_PROVIDER=auto
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8

# --- Media tools --------------------------------------------------------
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
